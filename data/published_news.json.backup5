          "signature": "c42b1ada83ef18efd1bf621ed8d7f34a2d21257fe6870789696139006ea84e36"
        },
        {
          "title": "AI disruption will challenge lending decisions in coming years - Goldman exec says",
          "summary": "A Goldman Sachs executive warned that artificial intelligence-driven models are reshaping risk assessment and lending decision-making, creating uncertainty for banks as they expand AI usage. The piece discusses how lenders must rethink credit-scoring, model governance, and the balance between automation and human oversight amid fast-paced AI deployment.",
          "source": "https://www.reuters.com/business/finance/ai-disruption-will-challenge-lending-decisions-coming-years-goldman-exec-says-2026-03-04/",
          "signature": "3edc78057135e5770e60347bdf486a09b34dc2d03a98c538d24212a3034da6ff"
        },
        {
          "title": "Citigroup raises AI capex and revenue forecasts amid rapid enterprise adoption",
          "summary": "Citigroup updated its AI spending and revenue outlook for 2026–2030, lifting global AI capex estimates to about 8.9 trillion and forecasting higher AI-driven revenue as large enterprises accelerate deployment. The bank cites strong momentum across industries and ongoing investments in hyperscalers and AI software.",
          "source": "https://www.reuters.com/technology/citigroup-raises-ai-capex-revenue-forecasts-amid-rapid-enterprise-adoption-2026-03-10/",
          "signature": "40b7dbf789606b99dfb88e0ecde8267eec66d293dbf7cb9b4ffc31af02fb3e7c"
        },
        {
          "title": "Chinese banks boost loans to tech sector as Beijing ramps up AI push",
          "summary": "Beijing’s policy stance to accelerate AI adoption is driving Chinese banks to increase lending to tech firms and AI-related ventures, signaling a credit impulse to support domestic AI development and deployment.",
          "source": "https://www.reuters.com/business/finance/chinese-banks-boost-loans-tech-sector-beijing-ramps-up-ai-push-2026-03-12/",
          "signature": "974f45e4cb183670e6314317bb7668b53128d63f3c57f91a48e189c6f39b0e93"
        }
      ]
