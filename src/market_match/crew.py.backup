from __future__ import annotations

import json
import os
from datetime import datetime
from pathlib import Path
from typing import Any, List

from rich.console import Console
from rich.panel import Panel

from crewai import Agent, Crew, Process, Task
from crewai.agents.agent_builder.base_agent import BaseAgent
from crewai.project import CrewBase, agent, crew, task
from crewai_tools import SerperDevTool, ScrapeWebsiteTool

from market_match.models import EconomyRecentNewsList, EnrichedNewsList, FinanceRecentNewsList, SportsRecentNewsList
from market_match.tools import ReadPublishedNewsTool, SavePublishedEditionTool
from market_match.utils.utils import extract_json, format_template, safe_slug
from market_match.utils.editions import export_edition, next_edition_number, render_newsletter_html

@CrewBase
class MarketMatch:
    """MarketMatch crew"""

    agents: List[BaseAgent]
    tasks: List[Task]

    ##############################################
    # --------- RESEARCH DEPARTMENT --------------
    ##############################################
    @agent
    def ai_sports_news_scout(self) -> Agent:
        return Agent(
            config=self.agents_config["ai_sports_news_scout"], 
            tools=[SerperDevTool(), ScrapeWebsiteTool(), ReadPublishedNewsTool()],
            verbose=True,
        )
        
    @agent
    def ai_finance_news_scout(self) -> Agent:
        return Agent(
            config=self.agents_config["ai_finance_news_scout"], 
            tools=[SerperDevTool(), ScrapeWebsiteTool(), ReadPublishedNewsTool()],
            verbose=True,
        )
        
    @agent
    def ai_economy_news_scout(self) -> Agent:
        return Agent(
            config=self.agents_config["ai_economy_news_scout"], 
            tools=[SerperDevTool(), ScrapeWebsiteTool(), ReadPublishedNewsTool()],
            verbose=True,
        )

    @agent
    def ai_news_enricher(self) -> Agent:
        return Agent(
            config=self.agents_config["ai_news_enricher"],
            tools=[SerperDevTool(), ScrapeWebsiteTool()],
            verbose=True,
        )
        
    @agent
    def ai_news_selector(self) -> Agent:
        return Agent(
            config=self.agents_config["ai_news_selector"],
            tools=[ScrapeWebsiteTool(), SavePublishedEditionTool()],
            verbose=True,
        )

    @task
    def find_ai_sports_news(self) -> Task:
        return Task(
            config=self.tasks_config["find_ai_sports_news"],
            output_pydantic=SportsRecentNewsList,
            async_execution=True,
        )
        
    @task
    def find_ai_finance_news(self) -> Task:
        return Task(
            config=self.tasks_config["find_ai_finance_news"],
            output_pydantic=FinanceRecentNewsList,
            async_execution=True,
        )
        
    @task
    def find_ai_economy_news(self) -> Task:
        return Task(
            config=self.tasks_config["find_ai_economy_news"],
            output_pydantic=EconomyRecentNewsList,
            async_execution=True,
        )

    @task
    def enrich_ai_news_research(self) -> Task:
        return Task(
            config=self.tasks_config["enrich_ai_news_research"],
            output_pydantic=EnrichedNewsList,
            async_execution=False,
        )
        
    @task
    def select_best_ai_news(self) -> Task:
        return Task(
            config=self.tasks_config["select_best_ai_news"],
            output_pydantic=EnrichedNewsList,
            async_execution=False,
        )
        
    ##############################################
    # ---------- WRITING DEPARTMENT --------------
    ##############################################

    @crew
    def crew(self) -> Crew:
        return Crew(
            agents=self.agents,
            tasks=self.tasks,
            process=Process.sequential,
            verbose=True,
            tracing=True
        )
























